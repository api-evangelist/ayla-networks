[
 {
  "page": "https://docs.aylanetworks.com/reference/sign-in.md",
  "definition": {
   "openapi": "3.1.0",
   "info": {
    "title": "sign-in",
    "version": "1.0"
   },
   "servers": [
    {
     "url": "https://user-dev.aylanetworks.com/"
    }
   ],
   "security": [
    {}
   ],
   "paths": {
    "/users/sign_in.json": {
     "post": {
      "summary": "Sign In",
      "description": "This API is used to sign a user into the Ayla IoT Cloud service. This API returns an access token and refresh token. The access token is required to use Ayla APIs. The refresh token can be used to obtain a new access token.\n\nTo use this API, you need the user's *email*, *password*, *app_id*, and *app_secret*.\n\nFollow these steps to get your *app_id* and *app_secret*:\n1. Log in to Alya Customer Dashboard.\n2. In the left navigation panel, click **OEM Profile**.\n3. Under the **Apps** tab, create a new app-id, or choose an existing app-id.",
      "operationId": "sign-in",
      "requestBody": {
       "content": {
        "application/json": {
         "schema": {
          "type": "object",
          "properties": {
           "RAW_BODY": {
            "type": "string",
            "format": "json"
           }
          }
         },
         "examples": {}
        }
       }
      },
      "responses": {
       "200": {
        "content": {
         "application/json": {
          "schema": {
           "type": "object",
           "properties": {
            "access_token": {
             "type": "string",
             "example": "9aa1fba14a6e4e08903db05bd64efa00"
            },
            "refresh_token": {
             "type": "string",
             "example": "d6edfe5a76ea47b3b3ba3e6b02a7ac22"
            },
            "expires_in": {
             "type": "integer",
             "example": 86400,
             "default": 0
            },
            "role": {
             "type": "string",
             "example": "EndUser"
            },
            "role_tags": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {}
             }
            }
           }
          },
          "examples": {
           "OK": {
            "summary": "OK",
            "value": {
             "access_token": "9aa1fba14a6e4e08903db05bd64efa00",
             "refresh_token": "d6edfe5a76ea47b3b3ba3e6b02a7ac22",
             "expires_in": 86400,
             "role": "EndUser",
             "role_tags": []
            }
           }
          }
         }
        },
        "description": "OK"
       },
       "401": {
        "content": {},
        "description": "Unauthorized"
       },
       "404": {
        "content": {},
        "description": "Not Found"
       }
      },
      "deprecated": false,
      "security": []
     }
    }
   },
   "x-readme": {
    "headers": [],
    "explorer-enabled": true,
    "proxy-enabled": true
   },
   "x-readme-fauxas": true
  }
 }
]