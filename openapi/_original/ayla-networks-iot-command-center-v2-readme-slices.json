   "paths": {
    "/jobs": {
     "post": {
      "summary": "Create job (New API)",
      "description": "This API creates a job. This single API covers filter, schedule, and OTA/Property/File Transfer jobs. This API provides efficient solution (when compared to the existing solution) to create a new job and better customer experience.",
      "operationId": "create-jobv2",
      "requestBody": {
       "content": {
        "application/json": {
         "schema": {
          "type": "object",
          "required": [
           "name",
           "type_id",
           "exec_method",
           "filter_id"
          ],
          "properties": {
           "name": {
            "type": "string",
            "description": "Job name."
           },
           "type_id": {
            "type": "integer",
            "description": "Job type identifier number. Any one of the following: <br> 1: Set properties <br> 2: OTA <br>3: File transfer",
            "format": "int32"
           },
           "filter_id": {
            "type": "integer",
            "description": "Unique filter identifier number",
            "format": "int32"
           },
           "exec_method": {
            "type": "string",
            "description": "Execution method: \"ONE_TIME\" or \"CONTINUOUS\"."
           },
           "delivery_option": {
            "type": "string",
            "description": "Delivery option: \"SYSTEM_PUSH\" or \"USER_CONSENT\"."
           },
           "oem_model": {
            "type": "string",
            "description": "OEM Model (required for Job or Filter)"
           },
           "description": {
            "type": "string",
            "description": "Short description of the job."
           },
           "job_metadata": {
            "properties": {
             "key": {
              "type": "string",
              "description": "Metadata key name."
             },
             "value": {
              "type": "string",
              "description": "Metadata key value."
             }
            },
            "required": [],
            "type": "object",
            "description": "List of data objects."
           },
           "retries": {
            "type": "integer",
            "description": "Number of retry if one of the action of the device is failure, how many times should retry the action.",
            "default": 0,
            "format": "int32"
           },
           "action_payload": {
            "type": "string",
            "description": "An object that is used for job action, the payload depends on different type of action.",
            "format": "json"
           },
           "stage_config": {
            "type": "string",
            "description": "A JSON string containing the stage configuration for the job.<br> <b>Example</b>:<br>stage_config: [     { stage: 1, devices: 10 },     { stage: 2, devices: * } ]",
            "format": "json"
           },
           "filter": {
            "type": "string",
            "description": "filter_id or filter. This is same as Filter Creation payload. For more information, please refer: <a href=\"https://docs.aylanetworks.com/reference/create-filter\" target=\"_blank\">Create filter</a>",
            "format": "json"
           },
           "schedule": {
            "type": "string",
            "description": "This is same as Schedule Creation payload. For more information, please refer:  <a href=\"https://docs.aylanetworks.com/reference/create-job-schedule\" target=\"_blank\">Create schedule</a>",
            "format": "json"
           }
          }
         }
        }
       }
      },
